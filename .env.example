# Leave unset locally to use a SQLite file (local.db) automatically.
# Render injects the real Postgres URL at deploy time via render.yaml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhooks

# How long background processing simulates a downstream API call for.
PROCESSING_DELAY_SECONDS=30

# Re-queue any transaction left PROCESSING from before the last restart.
RECOVER_STUCK_ON_STARTUP=true
